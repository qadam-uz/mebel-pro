# Environment / secrets — every `.env*` is gitignored except the two templates.
.env
.env.*
!.env.dev.example
!.env.prod.example
*.pem
*.key

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

