# Docker Compose env for the deploy/ stack — DEV defaults, ready to use:
#
#   cp .env.dev.example .env && docker compose up --build
#
# Defaults are filled in; no edits needed for local dev. For production copy
# `.env.prod.example` instead — same shape, secrets as {{change-me}}.
#
# Read by `compose.yaml` (dev — standalone, local Postgres + MinIO). The prod
# stack (`compose.prod.yaml`) shares the same env-var names.

# --- General ----------------------------------------------------------------

# HTTP Basic credentials for /docs, /api-docs, /api-redoc.
DOCS_AUTH_USERNAME=docs
DOCS_AUTH_PASSWORD=docs

# Dev only. Path (relative to this directory) to a `cutting-engine` checkout to
# run instead of the wheel pinned in backend/uv.lock — its `src/` goes first on
# the container's PYTHONPATH and is watched for autoreload, so engine changes
# are exercised by the API without publishing a release. Point it at a
# throwaway empty directory to fall back to the pinned wheel.
CUTTING_ENGINE_SRC=../../cutting-engine

# --- Telegram bot (client sign-in + client notifications) --------------------
# One bot serves both: the deep-link sign-in handshake and outbound order
# notifications. The username is public — it builds the t.me links the login
# card renders — so it ships filled in. Leave the secrets empty locally: dev
# mode below covers sign-in and outbound sends are skipped while the token is
# unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=mebel_pro_uz_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_API_TIMEOUT_SECONDS=5
TELEGRAM_LOGIN_CODE_PEPPER=dev-telegram-login-code-pepper-change-in-prod

# Dev sign-in without a real bot: a dev-only operation confirms any pending
# login token as a given phone, so the login page's poll succeeds with no
# Telegram at all (this is what E2E drives). MUST be false in prod. See
# docs/ref/features/access-management.md -> "Dev & local sign-in".
TELEGRAM_LOGIN_DEV_MODE=true
ALLOW_PROD_TELEGRAM_LOGIN_DEV_MODE=false

# Master switch for the per-IP login-token budget and the code-redeem throttle.
# Local E2E sets it to false so parallel browser tests from one localhost IP
# do not exhaust the bucket.
TELEGRAM_LOGIN_RATE_LIMITS_ENABLED=true
TELEGRAM_LOGIN_TOKENS_PER_IP_PER_HOUR=30
TELEGRAM_LOGIN_TOKENS_PER_IP_PER_DAY=100
TELEGRAM_LOGIN_CODE_REDEEMS_PER_IP=10
TELEGRAM_LOGIN_CODE_REDEEM_WINDOW_SECONDS=60

# Public origin of the client SPA — builds the order links in bot messages.
CLIENT_APP_BASE_URL=http://localhost:5173

TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]

# Password login throttle (platform + workshop sign-in): failed attempts per
# client IP in a sliding window. In-memory and process-local — the app runs as
# a single instance. Complements the per-account lockout, which can't cover
# logins shared across workshops or guessing rotated across many accounts.
LOGIN_IP_THROTTLE_ENABLED=true
LOGIN_IP_MAX_FAILURES=20
LOGIN_IP_WINDOW_SECONDS=900

# Public workshop-link resolve budget per client IP (the unauthenticated
# /public/workshop-links lookup behind every /w/{code} landing).
PUBLIC_LINK_THROTTLE_ENABLED=true
PUBLIC_LINK_LOOKUPS_PER_IP=60
PUBLIC_LINK_WINDOW_SECONDS=60

# --- Postgres ---------------------------------------------------------------
# Creates the local dev container with these credentials.
POSTGRES_USER=mebel
POSTGRES_PASSWORD=mebel
POSTGRES_DB=mebel

# Connection pool (mirrors backend/.env.dev.example). SIZE + MAX_OVERFLOW caps
# concurrent connections from the backend process; TIMEOUT is the wait for a free
# one before failing — short so exhaustion is a traceable error, not a stall.
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# --- MinIO ------------------------------------------------------------------
# Also become the local MinIO container's admin credentials; `createbuckets`
# creates MINIO_BUCKET on first up.
MINIO_ACCESS_KEY_ID=mebel
MINIO_SECRET_ACCESS_KEY=mebel-secret
MINIO_BUCKET=mebel

# --- Edge (only used by compose.prod.yaml) ----------------------------------
# Irrelevant to the dev stack; set to lvh.me so a local prod-stack smoke test
# (compose.prod.yaml) resolves *.lvh.me → 127.0.0.1.
BASE_DOMAIN=lvh.me
ACME_EMAIL=
