# Docker Compose environment. Copy to `.env` in this directory:  cp .env.example .env
# Used by compose.yaml / compose.override.yaml / compose.prod.yaml.

# App env: dev | prod  (override.yaml forces dev; prod.yaml forces prod)
ENV=dev
DEBUG=true

# Postgres (also consumed by the backend container)
POSTGRES_USER=mebel
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=mebel

# MinIO / S3 object store (the `files` module's blob store). The root creds are
# the MinIO admin AND what the backend uses as its S3 access key/secret.
# CHANGE THE PASSWORD in prod.
MINIO_ROOT_USER=mebel
MINIO_ROOT_PASSWORD=change-me-in-prod
S3_BUCKET=mebel

# CORS origins the backend will accept (JSON array, as a string)
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# HTTP Basic credentials for /docs and the OpenAPI UIs (/api-docs, /api-redoc).
# CHANGE THESE in prod — these pages are reachable through the edge.
DOCS_AUTH_USERNAME=docs
DOCS_AUTH_PASSWORD=change-me

# Frontend build-time API base URL. Leave empty: dev uses Vite's proxy, prod
# uses the Caddy edge — both serve the API under the same origin at /api.
VITE_API_BASE_URL=

# --- Prod edge (compose.prod.yaml only) -------------------------------------
# The apex domain. Caddy serves four sites derived from it:
#   • {BASE_DOMAIN}           → landing
#   • app.{BASE_DOMAIN}       → client SPA       (+ /api/* → backend)
#   • workshop.{BASE_DOMAIN}  → workshop SPA     (+ /api/* → backend)
#   • admin.{BASE_DOMAIN}     → superadmin SPA   (+ /api/* + /docs/* + OpenAPI UIs → backend)
# Each subdomain auto-provisions a Let's Encrypt cert; the box must be reachable
# on 80 + 443, and DNS for the apex + the three subdomains must point at it.
# For local stack testing, use BASE_DOMAIN=lvh.me (resolves *.lvh.me → 127.0.0.1).
BASE_DOMAIN=mebel-pro.uz
# Optional: email registered with the ACME CA (certificate-expiry notices).
ACME_EMAIL=
