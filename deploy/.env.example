# Docker Compose environment for the deploy/ stack. Copy to `.env` here:
#
#   cp .env.example .env
#
# This file is dev-oriented (defaults filled in). For production, use
# `.env.production` instead — it's the same shape with {{change-me}}
# placeholders for the secret values.
#
# Read by both `compose.yaml` (dev — standalone, local Postgres + MinIO) and
# `compose.prod.yaml` (prod — standalone, no local data services; the backend
# joins the external `infra-net` Docker network and reaches the shared
# `postgres` + `minio` services by name). The two compose files share the
# same env-var names.

# --- General ----------------------------------------------------------------

# Build-time API base URL baked into the web bundle. Leave empty in every
# environment we run today: dev uses Vite's proxy, prod uses the Caddy edge —
# both serve the API same-origin under /api.
VITE_API_BASE_URL=

# CORS origins the backend accepts (JSON array literal, as a string).
# Empty in prod (same-origin via the edge means no cross-origin requests).
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# HTTP Basic credentials for /docs, /api-docs, /api-redoc. The live docs site
# is reachable through the prod edge at admin.<BASE_DOMAIN>/docs.
DOCS_AUTH_USERNAME=docs
DOCS_AUTH_PASSWORD=docs

# --- Postgres ---------------------------------------------------------------
# DEV  : creates the local container with these credentials.
# PROD : connection credentials on the SHARED Postgres on `infra-net`. The DB
#        and user must already exist on the shared instance. Host is fixed as
#        `postgres` (the service name on infra-net).
POSTGRES_USER=mebel
POSTGRES_PASSWORD=mebel
POSTGRES_DB=mebel

# --- MinIO ------------------------------------------------------------------
# DEV  : these values also become the local MinIO container's admin credentials
#        (the compose wires them as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD). The
#        `createbuckets` one-shot creates MINIO_BUCKET on first up.
# PROD : credentials of an access key on the SHARED MinIO (create one via its
#        console). The bucket must already exist — provision it once via the
#        MinIO console or `mc`; the prod stack does NOT auto-create it. Host
#        is fixed as `minio` (the service name on infra-net).
MINIO_ACCESS_KEY_ID=mebel
MINIO_SECRET_ACCESS_KEY=mebel
MINIO_BUCKET=mebel

# --- Prod edge (compose.prod.yaml only) -------------------------------------
# The apex. Caddy serves four sites derived from it:
#   • {BASE_DOMAIN}           → static SEO landing
#   • app.{BASE_DOMAIN}       → client SPA       (+ /api/* → backend)
#   • workshop.{BASE_DOMAIN}  → workshop SPA     (+ /api/* → backend)
#   • admin.{BASE_DOMAIN}     → superadmin SPA   (+ /api/* + /docs + OpenAPI UIs → backend)
# Each subdomain auto-provisions a Let's Encrypt cert; the box must be
# reachable on 80 + 443, and DNS for all four hosts must point at it.
# For local stack testing, use BASE_DOMAIN=lvh.me (resolves *.lvh.me → 127.0.0.1).
BASE_DOMAIN=mebel-pro.uz
# Optional: email registered with the ACME CA (certificate-expiry notices).
ACME_EMAIL=
