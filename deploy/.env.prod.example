# Docker Compose env for the deploy/ stack — PROD shape. Copy to `.env`, replace
# every {{change-me}}, then `chmod 600 .env`:
#
#   cp .env.prod.example .env
#
# Read by `compose.prod.yaml` (standalone, no local data services — the backend
# joins the external `infra-net` network and reaches the shared `postgres` +
# `minio` by name). Non-secret values already carry prod-sane settings.

# --- General ----------------------------------------------------------------

# HTTP Basic credentials for /docs, /api-docs, /api-redoc (gates
# admin.<BASE_DOMAIN>/docs).
DOCS_AUTH_USERNAME=docs
DOCS_AUTH_PASSWORD={{change-me}}

# Client phone-OTP dev sign-in — MUST stay empty in prod. A non-empty value is a
# sign-in bypass, treated as a boot-time misconfiguration unless the temporary
# pre-production testing override is explicitly enabled. See
# docs/ref/features/access-management.md → "Dev & local sign-in".
OTP_DEV_CODES=[]
ALLOW_PROD_OTP_DEV_CODES=false
OTP_RATE_LIMITS_ENABLED=true

# OTP send budgets — every delivered code is a paid Telegram Gateway message.
# Hourly/daily caps per phone, per client IP, and platform-wide; the global
# daily cap is the hard ceiling on the worst-case Telegram bill. Failed
# deliveries count too. Tunable without a deploy (env edit + restart).
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PHONE_SENDS_PER_HOUR=5
OTP_PHONE_SENDS_PER_DAY=10
OTP_IP_SENDS_PER_HOUR=30
OTP_IP_SENDS_PER_DAY=50
OTP_GLOBAL_SENDS_PER_HOUR=150
OTP_GLOBAL_SENDS_PER_DAY=1000

OTP_CODE_PEPPER={{change-me}}
TELEGRAM_GATEWAY_ACCESS_TOKEN={{change-me}}
TELEGRAM_GATEWAY_API_BASE_URL=https://gatewayapi.telegram.org
TELEGRAM_GATEWAY_TIMEOUT_SECONDS=5
# Only X-Forwarded-For from peers inside these CIDRs is trusted (right-most
# untrusted hop wins). Must match the pinned `default` network subnet in
# compose.prod.yaml — the per-IP OTP limits are inert without it.
TRUSTED_PROXY_CIDRS=["172.29.0.0/24"]

# Password login throttle (platform + workshop sign-in): failed attempts per
# client IP in a sliding window. In-memory and process-local — the app runs as
# a single instance. Complements the per-account lockout, which can't cover
# logins shared across workshops or guessing rotated across many accounts.
LOGIN_IP_THROTTLE_ENABLED=true
LOGIN_IP_MAX_FAILURES=20
LOGIN_IP_WINDOW_SECONDS=900

# --- Postgres ---------------------------------------------------------------
# Connection credentials on the SHARED Postgres on `infra-net`. The DB and user
# must already exist on the shared instance. Host is fixed as `postgres`.
POSTGRES_USER=mebel
POSTGRES_PASSWORD={{change-me}}
POSTGRES_DB=mebel

# --- MinIO ------------------------------------------------------------------
# Credentials of an access key on the SHARED MinIO (create one via its console).
# The bucket must already exist — provision it once; the prod stack does NOT
# auto-create it. Host is fixed as `minio`.
MINIO_ACCESS_KEY_ID={{change-me}}
MINIO_SECRET_ACCESS_KEY={{change-me}}
MINIO_BUCKET=mebel

# --- Prod edge (compose.prod.yaml only) -------------------------------------
# The apex. Caddy serves four sites derived from it:
#   • {BASE_DOMAIN}           → static SEO landing
#   • app.{BASE_DOMAIN}       → client SPA       (+ /api/* → backend)
#   • workshop.{BASE_DOMAIN}  → workshop SPA     (+ /api/* → backend)
#   • admin.{BASE_DOMAIN}     → superadmin SPA   (+ /api/* + /docs + OpenAPI UIs → backend)
# Each subdomain auto-provisions a Let's Encrypt cert; the box must be reachable
# on 80 + 443, and DNS for all four hosts must point at it.
BASE_DOMAIN={{change-me}}
# Email registered with the ACME CA (certificate-expiry notices).
ACME_EMAIL={{change-me}}

# Host for the Taqsim Telegram Mini App — a separate compose stack in
# /opt/taqsim on this same box that publishes no ports. The edge terminates TLS
# for it and proxies to `taqsim-web:80` over infra-net. Bare host, NO scheme;
# taqsim's own .env wants the same host with the https:// scheme.
#
# Optional — compose defaults it to taqsim-ai.uz, so leave this commented out
# unless the Mini App moves. Never set it to an empty string: Caddy would
# reject the whole config and the edge would fail to start.
# TAQSIM_DOMAIN=taqsim-ai.uz
