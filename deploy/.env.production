# Production env template. Copy to `.env` on the server and replace every
# `{{change-me}}` value before the first deploy:
#
#   cp deploy/.env.production deploy/.env
#   $EDITOR deploy/.env
#   chmod 600 deploy/.env
#
# Used by `compose.prod.yaml`. NOT auto-loaded — the deploy script reads
# `deploy/.env` (this file is just the template).
#
# Operating context: the VPS already runs a SHARED Postgres and MinIO on the
# external Docker network `infra-net` (also used by other projects on the
# same host). The backend joins that network and reaches them by service name
# (`postgres`, `minio`). The DB, the Postgres user, the MinIO access key, and
# the bucket must all be provisioned out-of-band on those shared services
# before the first deploy — this stack does not create them.

# --- General ----------------------------------------------------------------

# Leave empty: the Caddy edge serves the API same-origin under /api on every
# SPA subdomain (no CORS needed inside the browser). Set this only if the web
# bundle ever needs to call an API on a different origin.
VITE_API_BASE_URL=

# CORS origins the backend accepts. Empty in prod (same-origin via the edge);
# add origins only if you ever need cross-origin callers (e.g. a third party).
BACKEND_CORS_ORIGINS=[]

# HTTP Basic credentials guarding /docs, /api-docs, /api-redoc on the prod
# edge. CHANGE BOTH — these pages are reachable on admin.<BASE_DOMAIN>.
DOCS_AUTH_USERNAME={{change-me}}
DOCS_AUTH_PASSWORD={{change-me}}

# --- Postgres (on the SHARED instance) --------------------------------------
# Credentials of an existing DB + user on the shared Postgres on `infra-net`.
# Provision once on the shared instance:
#   docker exec -it postgres psql -U postgres -c "CREATE DATABASE mebel_pro;"
#   docker exec -it postgres psql -U postgres -c "CREATE USER mebel_pro WITH PASSWORD '<secret>';"
#   docker exec -it postgres psql -U postgres -c "GRANT ALL PRIVILEGES ON DATABASE mebel_pro TO mebel_pro;"
# Host is fixed to `postgres` (the service name on infra-net) in compose.prod.yaml.
POSTGRES_USER={{change-me}}
POSTGRES_PASSWORD={{change-me}}
POSTGRES_DB={{change-me}}

# --- MinIO (on the SHARED instance) -----------------------------------------
# Credentials of an access key on the shared MinIO + a bucket that already
# exists. Create both once via the MinIO console (or `mc admin user svcacct
# add` + `mc mb`); the prod stack does NOT auto-create the bucket. Host is
# fixed to `minio` (the service name on infra-net) in compose.prod.yaml.
MINIO_ACCESS_KEY_ID={{change-me}}
MINIO_SECRET_ACCESS_KEY={{change-me}}
MINIO_BUCKET=mebel-pro

# --- Edge (Caddy) -----------------------------------------------------------
# The apex domain. Caddy auto-provisions a Let's Encrypt cert for each of:
#   {BASE_DOMAIN}            → static landing
#   app.{BASE_DOMAIN}        → client SPA      (+ /api/* → backend)
#   workshop.{BASE_DOMAIN}   → workshop SPA    (+ /api/* → backend)
#   admin.{BASE_DOMAIN}      → superadmin SPA  (+ /api/* + /docs + OpenAPI UIs → backend)
# Pre-reqs: DNS A/AAAA for all four hosts pointed at this box, ports 80 + 443
# reachable from the internet. (80 is also used for the ACME HTTP-01 challenge.)
BASE_DOMAIN=mebel-pro.uz
# Email registered with Let's Encrypt for expiry / outage notices. Optional
# but recommended.
ACME_EMAIL={{change-me}}
