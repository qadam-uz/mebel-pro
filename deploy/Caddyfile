# Edge router for the production stack. Plain HTTP only — it does NOT
# terminate TLS. Routes by subdomain to the internal services. Baked into the
# `edge` image (edge.Dockerfile); compose.prod.yaml publishes it on
# 127.0.0.1:8080 only.
#
# TLS lives on the HOST: the VPS runs a host-level nginx + certbot on 80/443
# that fronts every project on the box (mebel-pro and an unrelated one). It
# terminates HTTPS, redirects www → apex, and proxies the four hosts below to
# 127.0.0.1:8080. That nginx config is managed on the server, not by this repo;
# the reference copy is deploy/nginx-host.conf.example.
#
# BASE_DOMAIN (from deploy/.env) — the apex, e.g. "mebelapp.uz". Caddy serves
# four sites derived from it:
#   • {$BASE_DOMAIN}           → static SEO landing
#   • app.{$BASE_DOMAIN}       → client SPA       (+ /api/* → backend)
#   • workshop.{$BASE_DOMAIN}  → workshop SPA     (+ /api/* → backend)
#   • admin.{$BASE_DOMAIN}     → superadmin SPA   (+ /api/* → backend,
#                                                  + /docs, /api-docs,
#                                                    /api-redoc → backend,
#                                                    HTTP Basic-gated server-side)
#
# Local stack testing: set BASE_DOMAIN=lvh.me (resolves *.lvh.me → 127.0.0.1)
# and hit the edge directly over plain HTTP — http://app.lvh.me:8080/ — or
# without DNS: curl -H 'Host: app.lvh.me' http://127.0.0.1:8080/
{
	# No ACME, no certificates, no HTTP→HTTPS redirect — the host nginx owns
	# TLS. The explicit http:// site addresses below already imply this; the
	# option makes it impossible to regress by dropping a scheme.
	auto_https off

	servers {
		# The host nginx reaches the edge through the published loopback port,
		# so Caddy sees the `default` network's gateway (172.29.0.1) as the
		# peer. Trusting it makes Caddy keep nginx's X-Forwarded-For (and
		# X-Forwarded-Proto) and append to it instead of discarding it — the
		# backend's per-IP limits depend on that. Nothing else can arrive from
		# the gateway: the port is bound to 127.0.0.1. Tied to the pinned
		# subnet in compose.prod.yaml — change both together.
		trusted_proxies static 172.29.0.1/32
	}
}

(common) {
	encode zstd gzip
	log

	# Cap request bodies (was nginx `client_max_body_size 25m`).
	request_body {
		max_size 25MB
	}
}

# Apex: the static SEO landing only. Role apps are served only on their
# documented subdomains; apex app paths intentionally 404.
http://{$BASE_DOMAIN} {
	import common

	handle / {
		rewrite * /landing/index.html
		reverse_proxy mebel-web:80
	}

	@landing_public path /landing/* /assets/* /favicon.svg /favicon.ico /apple-touch-icon-180.png /site.webmanifest /icon-* /maskable-*
	handle @landing_public {
		reverse_proxy mebel-web:80
	}

	handle {
		respond "Not found" 404
	}
}

# Client SPA + same-origin API.
http://app.{$BASE_DOMAIN} {
	import common

	handle /api/* {
		reverse_proxy backend:8000 {
			# The backend container runs `alembic upgrade head` BEFORE uvicorn binds
			# the port, so every deploy leaves a window where this upstream refuses
			# connections. Without a retry window Caddy turns that into a hard 502
			# for real users on every merge to main. Retry instead of failing.
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}

	@client_public path /assets/* /favicon.svg /favicon.ico /apple-touch-icon-180.png /site.webmanifest /icon-* /maskable-*
	handle @client_public {
		reverse_proxy mebel-web:80
	}

	handle {
		rewrite * /client/index.html
		reverse_proxy mebel-web:80
	}
}

# Workshop SPA + same-origin API.
http://workshop.{$BASE_DOMAIN} {
	import common

	handle /api/* {
		reverse_proxy backend:8000 {
			# The backend container runs `alembic upgrade head` BEFORE uvicorn binds
			# the port, so every deploy leaves a window where this upstream refuses
			# connections. Without a retry window Caddy turns that into a hard 502
			# for real users on every merge to main. Retry instead of failing.
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}

	@workshop_public path /assets/* /favicon.svg /favicon.ico /apple-touch-icon-180.png /site.webmanifest /icon-* /maskable-*
	handle @workshop_public {
		reverse_proxy mebel-web:80
	}

	handle {
		rewrite * /workshop/index.html
		reverse_proxy mebel-web:80
	}
}

# Superadmin SPA + same-origin API + the live docs site + OpenAPI UIs.
http://admin.{$BASE_DOMAIN} {
	import common

	@backend path /api/* /docs /docs/* /api-docs /api-docs/* /api-redoc /api-redoc/*
	handle @backend {
		reverse_proxy backend:8000 {
			# The backend container runs `alembic upgrade head` BEFORE uvicorn binds
			# the port, so every deploy leaves a window where this upstream refuses
			# connections. Without a retry window Caddy turns that into a hard 502
			# for real users on every merge to main. Retry instead of failing.
			lb_try_duration 30s
			lb_try_interval 500ms
		}
	}

	@admin_public path /assets/* /favicon.svg /favicon.ico /apple-touch-icon-180.png /site.webmanifest /icon-* /maskable-*
	handle @admin_public {
		reverse_proxy mebel-web:80
	}

	handle {
		rewrite * /admin/index.html
		reverse_proxy mebel-web:80
	}
}
