# Edge reverse proxy for the production stack — the only container published to
# the host. Terminates HTTP/HTTPS and routes by subdomain to the internal
# services. Mounted into the `edge` service by compose.prod.yaml.
#
# BASE_DOMAIN (from deploy/.env) — the apex, e.g. "mebel-pro.uz". Caddy serves
# four sites derived from it:
#   • {$BASE_DOMAIN}           → static SEO landing
#   • app.{$BASE_DOMAIN}       → client SPA       (+ /api/* → backend)
#   • workshop.{$BASE_DOMAIN}  → workshop SPA     (+ /api/* → backend)
#   • admin.{$BASE_DOMAIN}     → superadmin SPA   (+ /api/* → backend,
#                                                  + /docs, /docs-uz,
#                                                    /api-docs, /api-redoc
#                                                    → backend,
#                                                    HTTP Basic-gated server-side)
#
# Auto-HTTPS: the box must be reachable from the internet on 80 and 443 and DNS
# for the apex and the three subdomains must point at it; Caddy obtains and
# renews a Let's Encrypt certificate per host.
#
# Local stack testing: set BASE_DOMAIN=lvh.me (resolves *.lvh.me → 127.0.0.1)
# and accept Caddy's internal-CA cert; or add the four hosts to /etc/hosts.
# ACME_EMAIL is accepted by Compose for future notification wiring. Caddy does
# not require an email address for ACME, and an empty email directive is invalid.

(common) {
	encode zstd gzip
	log

	# Cap request bodies (was nginx `client_max_body_size 25m`).
	request_body {
		max_size 25MB
	}
}

# Apex: the static SEO landing only. Role apps are served only on their
# documented subdomains; apex app/prototype paths intentionally 404.
{$BASE_DOMAIN} {
	import common

	handle / {
		rewrite * /landing/index.html
		reverse_proxy web:80
	}

	@landing_public path /landing/* /assets/* /favicon.svg /favicon.ico /apple-touch-icon-180.png /site.webmanifest /icon-* /maskable-*
	handle @landing_public {
		reverse_proxy web:80
	}

	handle {
		respond "Not found" 404
	}
}

# Client SPA + same-origin API.
app.{$BASE_DOMAIN} {
	import common

	handle /api/* {
		reverse_proxy backend:8000
	}

	@client_public path /assets/* /favicon.svg /favicon.ico /apple-touch-icon-180.png /site.webmanifest /icon-* /maskable-*
	handle @client_public {
		reverse_proxy web:80
	}

	handle {
		rewrite * /client/index.html
		reverse_proxy web:80
	}
}

# Workshop SPA + same-origin API.
workshop.{$BASE_DOMAIN} {
	import common

	handle /api/* {
		reverse_proxy backend:8000
	}

	@workshop_public path /assets/* /favicon.svg /favicon.ico /apple-touch-icon-180.png /site.webmanifest /icon-* /maskable-*
	handle @workshop_public {
		reverse_proxy web:80
	}

	handle {
		rewrite * /workshop/index.html
		reverse_proxy web:80
	}
}

# Superadmin SPA + same-origin API + the live docs site + OpenAPI UIs.
admin.{$BASE_DOMAIN} {
	import common

	@backend path /api/* /docs /docs/* /docs-uz /docs-uz/* /api-docs /api-docs/* /api-redoc /api-redoc/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# TEMPORARY: /prototypes serves the prototype-full reference from baked-in
	# static files (see web/Dockerfile + web/nginx.conf).
	@admin_public path /assets/* /favicon.svg /favicon.ico /apple-touch-icon-180.png /site.webmanifest /icon-* /maskable-* /prototypes /prototypes/*
	handle @admin_public {
		reverse_proxy web:80
	}

	handle {
		rewrite * /admin/index.html
		reverse_proxy web:80
	}
}
