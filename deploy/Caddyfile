# Edge reverse proxy for the production stack — the only container published to
# the host. Terminates HTTP/HTTPS and routes by subdomain to the internal
# services. Mounted into the `edge` service by compose.prod.yaml.
#
# BASE_DOMAIN (from deploy/.env) — the apex, e.g. "mebel-pro.uz". Caddy serves
# four sites derived from it:
#   • {$BASE_DOMAIN}           → static SEO landing
#   • app.{$BASE_DOMAIN}       → client SPA       (+ /api/* → backend)
#   • workshop.{$BASE_DOMAIN}  → workshop SPA     (+ /api/* → backend)
#   • admin.{$BASE_DOMAIN}     → superadmin SPA   (+ /api/* → backend,
#                                                  + /docs, /api-docs,
#                                                    /api-redoc → backend,
#                                                    HTTP Basic-gated server-side)
#
# Auto-HTTPS: the box must be reachable from the internet on 80 and 443 and DNS
# for the apex and the three subdomains must point at it; Caddy obtains and
# renews a Let's Encrypt certificate per host.
#
# Local stack testing: set BASE_DOMAIN=lvh.me (resolves *.lvh.me → 127.0.0.1)
# and accept Caddy's internal-CA cert; or add the four hosts to /etc/hosts.
# ACME_EMAIL (optional) is registered with the ACME CA for expiry notices.
{
	email {$ACME_EMAIL:}
}

(common) {
	encode zstd gzip
	log

	# Cap request bodies (was nginx `client_max_body_size 25m`).
	request_body {
		max_size 25MB
	}
}

# Apex: the static SEO landing only. The `web` image builds both the Vue
# client SPA (dist/index.html) and the standalone landing
# (dist/landing/index.html); nginx serves index.html at `/`, so the apex
# rewrites the bare path to the landing. The landing's own static refs
# (/favicon.*, /site.webmanifest, fingerprinted /assets/*) live at the web
# root and pass through untouched.
{$BASE_DOMAIN} {
	import common

	@root path /
	rewrite @root /landing/index.html

	reverse_proxy web:80
}

# Client SPA + same-origin API.
app.{$BASE_DOMAIN} {
	import common

	@api path /api/*
	reverse_proxy @api backend:8000

	reverse_proxy web:80
}

# Workshop SPA + same-origin API.
workshop.{$BASE_DOMAIN} {
	import common

	@api path /api/*
	reverse_proxy @api backend:8000

	reverse_proxy web:80
}

# Superadmin SPA + same-origin API + the live docs site + OpenAPI UIs.
admin.{$BASE_DOMAIN} {
	import common

	@backend path /api/* /docs /docs/* /api-docs /api-docs/* /api-redoc /api-redoc/*
	reverse_proxy @backend backend:8000

	# TEMPORARY: /prototypes (static design gallery) needs no rule of its own —
	# it falls through to the `web` container below, which serves it from
	# baked-in static files. Remove the prototypes once a design system is
	# committed to web/DESIGN.md (see web/Dockerfile + web/nginx.conf).
	reverse_proxy web:80
}
