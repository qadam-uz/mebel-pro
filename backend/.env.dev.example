# Backend env — DEV defaults, ready to use. Copy to `.env` for local non-Docker
# runs and start the server; no edits needed.
# (Docker Compose reads deploy/.env instead — see deploy/.env.dev.example.)
ENV=dev
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mebel
POSTGRES_PASSWORD=mebel
POSTGRES_DB=mebel

# Optional: full SQLAlchemy URL; overrides POSTGRES_* when set.
# DATABASE_URL=postgresql+asyncpg://mebel:mebel@localhost:5432/mebel

# Connection pool. SIZE + MAX_OVERFLOW is the ceiling of concurrent connections
# this process opens — keep it under the server's max_connections, which is
# shared with other projects. TIMEOUT is how long a request waits for a free
# connection before failing; short on purpose, so exhaustion surfaces as a
# traceable error instead of a 30 s stall that reads as a frozen app.
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# Object storage (MinIO) — the `files` module's blob store. Protocol is
# S3-compatible. Point MINIO_ENDPOINT_URL at a running MinIO:
# `docker compose -f deploy/compose.yaml up -d minio`.
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY_ID=mebel
MINIO_SECRET_ACCESS_KEY=mebel-secret
MINIO_BUCKET=mebel
MINIO_USE_SSL=false

# Directory rendered live at /docs (Markdown → HTML). Defaults to the repo's
# docs/; only set this if you keep the docs tree somewhere else.
# DOCS_DIR=../docs

# HTTP Basic credentials for /docs *and* the OpenAPI UIs (/api-docs, /api-redoc).
DOCS_AUTH_USERNAME=docs
DOCS_AUTH_PASSWORD=docs

# Client phone-OTP dev sign-in. A list of fixed codes that bypass Telegram
# delivery: when non-empty, no code is sent and verification accepts any listed
# code for any phone (sign in as any number with 000000). MUST be empty in prod
# — see docs/ref/features/access-management.md → "Dev & local sign-in".
OTP_DEV_CODES=["000000"]
ALLOW_PROD_OTP_DEV_CODES=false
OTP_RATE_LIMITS_ENABLED=true

# OTP send budgets — every delivered code is a paid Telegram Gateway message.
# Hourly/daily caps per phone, per client IP, and platform-wide; the global
# daily cap is the hard ceiling on the worst-case Telegram bill. Failed
# deliveries count too. Tunable without a deploy (env edit + restart).
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PHONE_SENDS_PER_HOUR=5
OTP_PHONE_SENDS_PER_DAY=10
OTP_IP_SENDS_PER_HOUR=30
OTP_IP_SENDS_PER_DAY=50
OTP_GLOBAL_SENDS_PER_HOUR=150
OTP_GLOBAL_SENDS_PER_DAY=1000

OTP_CODE_PEPPER=dev-otp-code-pepper-change-in-prod
TELEGRAM_GATEWAY_ACCESS_TOKEN=
TELEGRAM_GATEWAY_API_BASE_URL=https://gatewayapi.telegram.org
TELEGRAM_GATEWAY_TIMEOUT_SECONDS=5
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]

# Password login throttle (platform + workshop sign-in): failed attempts per
# client IP in a sliding window. In-memory and process-local — the app runs as
# a single instance. Complements the per-account lockout, which can't cover
# logins shared across workshops or guessing rotated across many accounts.
LOGIN_IP_THROTTLE_ENABLED=true
LOGIN_IP_MAX_FAILURES=20
LOGIN_IP_WINDOW_SECONDS=900

# Public workshop-link resolve budget per client IP (the unauthenticated
# /public/workshop-links lookup behind every /w/{code} landing).
PUBLIC_LINK_THROTTLE_ENABLED=true
PUBLIC_LINK_LOOKUPS_PER_IP=60
PUBLIC_LINK_WINDOW_SECONDS=60
