# Backend environment. Copy to `.env` for local non-Docker runs.
# (Docker Compose reads deploy/.env instead — see deploy/.env.example.)
ENV=dev
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mebel
POSTGRES_PASSWORD=mebel
POSTGRES_DB=mebel

# Optional: full SQLAlchemy URL; overrides POSTGRES_* when set.
# DATABASE_URL=postgresql+asyncpg://mebel:mebel@localhost:5432/mebel

BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Object storage (MinIO) — the `files` module's blob store. Protocol is
# S3-compatible. Point MINIO_ENDPOINT_URL at a running MinIO:
# `docker compose -f deploy/compose.yaml up -d minio`.
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY_ID=mebel
MINIO_SECRET_ACCESS_KEY=mebel
MINIO_BUCKET=mebel
MINIO_USE_SSL=false
# Hard cap on a single uploaded blob (bytes). Default 10 MiB.
MAX_UPLOAD_BYTES=10485760

# Directory rendered live at /docs (Markdown → HTML). Defaults to the repo's
# docs/; only set this if you keep the docs tree somewhere else.
# DOCS_DIR=../docs

# HTTP Basic credentials for /docs *and* the OpenAPI UIs (/api-docs, /api-redoc).
# Change these for any deploy that's reachable beyond localhost.
DOCS_AUTH_USERNAME=docs
DOCS_AUTH_PASSWORD=docs

# Client auth — Telegram Login Widget (OAuth). The bot token keys the HMAC that
# verifies the widget payload; the username is what the widget renders. Leave
# both EMPTY in local dev — the signature check is then skipped so the client
# app works without a bot. With ENV=prod the app refuses to boot on an empty
# token (an empty token there would make client sign-in forgeable).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
